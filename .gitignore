# Byte-compiled
*.py[cod]
*$py.class
__pycache__/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# uv / venv
.venv/
venv/
env/

# Project
outputs/
checkpoints/
*.pt
*.pth
*.ckpt

# Data
# `data/**/` excludes directories outright, so git never descends into them and a bare
# `!data/<dir>/` negation cannot re-include anything. Un-ignoring a subtree needs both the
# directory and its contents, as the negations below do. The platemap tree the tests
# need is committed under tests/fixtures/ instead, so it lives with the tests that read it.
data/**/
data/.cache/

# Reference metadata (small, required by the benchmark harness and splits)
!data/reference/
!data/reference/**

# CPJUMP1 platemaps and JUMP-Target annotations (small, required by MetadataIndex;
# `morphoclip data fetch --metadata` refreshes them from the public S3 bucket)
!data/metadata/
!data/metadata/**

# Environment / secrets
.env
.env.*
!.env.example

